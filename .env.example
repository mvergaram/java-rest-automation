# Copy this file to .env (git-ignored) or export these as real environment variables.
# TestConfig reads environment variables first, falling back to
# src/test/resources/config.properties only for non-secret defaults.

# Base URL of the in-house presign endpoint, e.g. https://media.internal.example.com
PRESIGN_BASE_URL=

# Twilio Account SID (starts with AC...), used for Basic Auth against intelligence.twilio.com
TWILIO_ACCOUNT_SID=

# Twilio Auth Token — also used as the HMAC-SHA1 key for the X-Twilio-Signature header
TWILIO_AUTH_TOKEN=

# Twilio Intelligence Service SID (starts with GA...)
TWILIO_SERVICE_SID=

# How the audioRef in each fixture is resolved into a media_url before step 1:
#   REFERENCE_ONLY        -> audioRef is already a publicly reachable URL, passed straight to presign
#   UPLOAD_THEN_REFERENCE -> audioRef is a local file path, uploaded first, then referenced
# Defaults to REFERENCE_ONLY if unset.
MEDIA_MODE=REFERENCE_ONLY

# Set to "true" to always log full request/response bodies, not just on assertion failure.
VERBOSE_HTTP_LOGS=false
