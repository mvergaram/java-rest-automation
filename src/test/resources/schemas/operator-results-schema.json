{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Twilio Intelligence OperatorResults",
  "type": "object",
  "required": ["operator_results"],
  "properties": {
    "operator_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operator_sid", "name", "operator_type"],
        "properties": {
          "operator_sid": { "type": "string", "pattern": "^OR[0-9a-f]{32}$" },
          "name": { "type": "string", "minLength": 1 },
          "operator_type": { "type": "string", "minLength": 1 },
          "match_probability": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
